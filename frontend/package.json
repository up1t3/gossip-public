{
  "name": "boltalka-frontend",
  "private": true,
  "version": "2.2.32",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "electron:start": "electron .",
    "electron:build": "npm run build && electron-builder",
    "cap:sync": "cap sync",
    "cap:copy": "cap copy",
    "cap:add:android": "cap add android",
    "cap:add:ios": "cap add ios",
    "apk:copy": "node copy-apk.js",
    "apk:build": "node build-apk.js release",
    "build:apk": "node build-apk.js debug",
    "test": "npm --prefix ../tests/e2e run test:e2e --",
    "test:qa": "node ../tests/e2e/pro_qa_run.js",
    "android:run": "npm run build && npx cap sync && npx cap run android",
    "android:log": "..\\android-sdk\\platform-tools\\adb.exe logcat *:S com.gossip.app:V WebConsole:V Capacitor:V Capacitor/Console:V BoltalkaVoIP:V AudioSessionPlugin:V VoIPNotificationPlugin:V MainActivity:V",
    "android:layout": "C:\\Users\\Up1t3\\AppData\\AndroidCLI\\android.exe --sdk=..\\android-sdk layout --pretty"
  },
  "dependencies": {
    "@7mind.io/sqlcipher-wasm": "^1.2.0",
    "@capacitor-community/file-opener": "^6.0.1",
    "@capacitor/android": "^6.0.0",
    "@capacitor/app": "^6.0.3",
    "@capacitor/core": "^6.0.0",
    "@capacitor/filesystem": "^6.0.4",
    "@capacitor/ios": "^6.0.0",
    "@capacitor/keyboard": "^6.0.4",
    "@capacitor/local-notifications": "^6.1.3",
    "@capacitor/push-notifications": "^6.0.0",
    "@capacitor/status-bar": "^6.0.3",
    "@ffmpeg/ffmpeg": "^0.12.10",
    "@ffmpeg/util": "^0.12.1",
    "@sqlite.org/sqlite-wasm": "^3.53.0-build1",
    "@types/qrcode": "^1.5.6",
    "better-sqlite3-multiple-ciphers": "^12.10.0",
    "emoji-picker-react": "^4.19.1",
    "framer-motion": "^11.2.10",
    "heic2any": "^0.0.4",
    "i18next": "^23.11.5",
    "i18next-browser-languagedetector": "^8.0.0",
    "katex": "^0.17.0",
    "lucide-react": "^0.395.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^14.1.2",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.0.0",
    "@types/katex": "^0.16.8",
    "@types/node": "^20.14.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.184.1",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "electron": "^31.0.1",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.4.5",
    "vite": "^5.3.1",
    "vite-plugin-pwa": "^0.20.0"
  },
  "build": {
    "appId": "com.gossip.app",
    "productName": "Gossip",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!dist/**/*.apk",
      "!dist/**/*.exe",
      "!dist/*.apk",
      "!dist/*.exe",
      "!node_modules/**/android/**",
      "!node_modules/**/ios/**"
    ],
    "win": {
      "target": "nsis"
    },
    "publish": null
  }
}
